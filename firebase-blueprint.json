{
  "entities": {
    "Registration": {
      "title": "Registration",
      "description": "Gaborone South Economic Initiatives Youth Pitso registration entry",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["individual", "company", "institution", "organisation"] },
        "fullName": { "type": "string", "maxLength": 150 },
        "idNumber": { "type": "string", "maxLength": 50, "description": "National Identity / Omang or Passport number" },
        "companyName": { "type": "string", "maxLength": 150 },
        "contactPerson": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 25 },
        "email": { "type": "string", "format": "email" },
        "ward": { "type": "string", "maxLength": 100 },
        "plotNumber": { "type": "string", "maxLength": 50 },
        "profession": { "type": "string", "maxLength": 100 },
        "sector": { "type": "string", "maxLength": 100 },
        "skillsOrServices": { "type": "string", "maxLength": 1000 },
        "employeeCount": { "type": "number", "minimum": 0 },
        "consentGiven": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "phone", "ward", "consentGiven"]
    },
    "ProgrammeStat": {
      "title": "ProgrammeStat",
      "description": "Counter for programme downloads",
      "type": "object",
      "properties": {
        "count": { "type": "number", "minimum": 0 }
      },
      "required": ["count"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization entry indexed by lowercase email",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Public registrations collection using Firestore auto document IDs"
    },
    "/programmeStats/{statDocId}": {
      "schema": "ProgrammeStat",
      "description": "Download statistics collection with document ID 'downloads'"
    },
    "/admins/{adminEmail}": {
      "schema": "Admin",
      "description": "Authorized administrator whitelist indexed by document ID matching lowercase email address"
    }
  }
}
