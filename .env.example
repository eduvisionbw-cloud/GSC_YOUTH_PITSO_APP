# ==============================================================
# Gaborone South Youth Pitso - Environment Variables Template
# Copy this file to .env.local or set these variables in Vercel.
# ==============================================================

# Required Firebase Web Client Configuration (Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional: Custom Firestore Database ID (leave empty if using the default database)
VITE_FIREBASE_DATABASE_ID=

# Admin Access Control (Comma-separated list of authorized administrator emails)
VITE_ADMIN_EMAILS=quintonbileon@gmail.com,admin@gaboronesouth.gov.bw

# Backend Server (Optional - if deploying full-stack Node server)
PORT=3000
GEMINI_API_KEY=
