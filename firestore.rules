rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user's email exists in the admins collection
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email != null 
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Helper function to validate public registration payload
    function isValidRegistration(data) {
      return data.type in ['individual', 'company']
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25
        && data.ward is string
        && data.consentGiven == true;
    }

    // Global default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Registrations collection
    match /registrations/{registrationId} {
      // Public create only if type is individual or company, phone is 7-25 chars, ward is string, consentGiven is true
      allow create: if isValidRegistration(request.resource.data);

      // Read, update, and delete only for admins
      allow read, update, delete: if isAdmin();
    }

    // 2. ProgrammeStats collection
    match /programmeStats/{statDocId} {
      // Public read
      allow read: if true;

      // Public increment by 1 only
      allow create: if statDocId == 'downloads' 
        && request.resource.data.count == 1;

      allow update: if statDocId == 'downloads' 
        && request.resource.data.count == resource.data.count + 1;
    }

    // 3. Admins collection
    match /admins/{adminEmail} {
      // Readable only by the signed-in user's own email or listing by admins
      allow get: if request.auth != null 
        && request.auth.token.email != null 
        && request.auth.token.email.lower() == adminEmail.lower();

      allow list: if isAdmin();

      // No client writes
      allow write: if false;
    }
  }
}
