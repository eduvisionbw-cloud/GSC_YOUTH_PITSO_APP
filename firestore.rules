rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Validate required fields for public registration creation
    function isValidRegistration(data) {
      return data.type in ['individual', 'company', 'institution', 'organisation']
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25
        && data.email is string && data.email.size() <= 150
        && data.ward is string && data.ward.size() <= 100
        && data.consent == true;
    }

    // Registrations collection
    match /registrations/{registrationId} {
      // Allow create for anyone with required fields validated
      allow create: if isValidRegistration(request.resource.data);

      // Read, update, and delete only for signed-in admin accounts
      allow read, update, delete: if isSignedIn();
    }

    // Application statistics counters
    match /stats/{statId} {
      // stats/programmeDownloads readable by anyone
      allow read: if true;

      // Updatable only by incrementing programmeDownloads counter by 1
      allow create: if statId == 'programmeDownloads' 
        && request.resource.data.count == 1;

      allow update: if statId == 'programmeDownloads' 
        && request.resource.data.count == resource.data.count + 1;
    }
  }
}
